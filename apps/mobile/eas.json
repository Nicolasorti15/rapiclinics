{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "clinical-apk": {
      "distribution": "internal",
      "environment": "production",
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_API_URL": "https://rapiclinics-api-test.onrender.com" },
      "android": { "buildType": "apk" }
    },
    "android-demo": {
      "extends": "device",
      "env": {
        "APP_VARIANT": "device",
        "APP_IDENTIFIER": "app.nicolasorti.rapiclinics.demo",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.4:8083"
      }
    },
    "development": { "developmentClient": true, "distribution": "internal" },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": true }
    },
    "device": {
      "distribution": "internal",
      "environment": "preview",
      "env": { "APP_VARIANT": "device" },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" },
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": { "production": {} }
}
